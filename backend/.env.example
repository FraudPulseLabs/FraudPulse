# =============================================================================
# FraudPulse backend — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` in this same directory (backend/) and fill in real
# values:   cp .env.example .env
#
# `.env` is gitignored — NEVER commit real passwords or Supabase secrets.
# =============================================================================

# ---- Database (REQUIRED) ----------------------------------------------------
# This is the ONLY variable the backend reads at runtime.
#   src/core/config.py -> get_env("DATABASE_URL")  (raises at import if unset)
#
# Get it from: Supabase dashboard -> Project Settings -> Database -> Connection string.
# Notes:
#   - Use the SQLAlchemy "psycopg" (v3) driver prefix: postgresql+psycopg://
#   - URL-encode any special characters in the password (e.g. @ -> %40).
#   - Keep ?sslmode=require for Supabase.
#
# RECOMMENDED — Supabase connection pooler (IPv4-compatible).
# The direct host (db.<ref>.supabase.co) is IPv6-ONLY for most projects now, so
# IPv4 / typical home networks get "getaddrinfo failed". Use the pooler instead.
#   - Session pooler  = port 5432  (full feature set; best for reflection/local dev)
#   - Transaction pooler = port 6543 (serverless / many short-lived connections)
# The username includes the project ref: postgres.<project_ref>.
# Copy the exact string (it has your region baked in) from the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> Session pooler.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Alternative — Direct connection. Works ONLY on IPv6-capable networks:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require


# ---- Supabase Auth (JWT verification) ---------------------------------------
# The backend verifies the JWT minted by Supabase Auth on protected /api/v1
# routes. It does NOT issue tokens. Verification uses the project's public JWKS
# (asymmetric keys — the modern Supabase default), so only the project URL is
# needed. If left unset, it is auto-derived from the project ref in DATABASE_URL,
# so for typical Supabase setups you can leave this commented out.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#
# Optional legacy fallback: if your project still uses the shared HS256 "JWT
# Secret" (Supabase -> Settings -> API -> JWT) instead of asymmetric keys, set it
# here and the backend will verify with HS256 instead of JWKS.
# SUPABASE_JWT_SECRET=

# ---- Not used by the backend ------------------------------------------------
# The backend talks to Postgres DIRECTLY via DATABASE_URL and does not call the
# Supabase REST/Storage API. Uncomment only if you later add such calls.
# SUPABASE_SERVICE_ROLE_KEY=
